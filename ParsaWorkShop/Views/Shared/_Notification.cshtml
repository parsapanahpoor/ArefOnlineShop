@using Microsoft.AspNetCore.Html
@if (TempData["SuccessMessage"] != null)
{
    <script>
        ShowMessage("اعلان", "@TempData["SuccessMessage"]", "success");
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        ShowMessage("خطا", "@(new HtmlString(TempData["ErrorMessage"] as string))", "error");
    </script>
}

@if (TempData["InfoMessage"] != null)
{
    <script>
        ShowMessage("اعلان", "@TempData["InfoMessage"]", "info");
    </script>
}

@if (TempData["WarningMessage"] != null)
{
    <script>
        ShowMessage("هشدار", "@TempData["WarningMessage"]", "warning");
    </script>
}